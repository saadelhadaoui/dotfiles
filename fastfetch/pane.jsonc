// Static info for the animated tmux pane (live stats are drawn by fetch-pane).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": { "separator": " ", "pipe": false },
  "modules": [
    { "type": "title",    "format": "{user-name}@{host-name}", "color": { "user": "magenta", "at": "white", "host": "blue" } },
    { "type": "os",       "key": "os     ", "keyColor": "magenta", "format": "{name} {version-id}" },
    { "type": "kernel",   "key": "kernel ", "keyColor": "magenta", "format": "{release}" },
    { "type": "packages", "key": "pkgs   ", "keyColor": "magenta" },
    { "type": "command",  "key": "shell  ", "keyColor": "blue", "text": "fish --version | awk '{print $1, $3}' | tr -d ," },
    { "type": "de",       "key": "de     ", "keyColor": "blue" },
    { "type": "wm",       "key": "wm     ", "keyColor": "blue" },
    { "type": "cpu",      "key": "cpu    ", "keyColor": "cyan", "format": "{name} ({cores-logical})" },
    { "type": "gpu",      "key": "gpu    ", "keyColor": "cyan", "format": "{name}" },
    { "type": "disk",     "key": "disk   ", "keyColor": "green", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" }
  ]
}
